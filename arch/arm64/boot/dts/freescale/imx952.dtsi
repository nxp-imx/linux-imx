		vpu3: vpu@4c4e0000 {
			compatible = "nxp,wave511-vpu";
			reg = <0x0 0x4c4e0000 0x0 0x400>;
			interrupts = <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_VPUDEC>, <&scmi_clk IMX952_CLK_VPUAPB>;
			clock-names = "vpu", "vpuapb";
			power-domains = <&scmi_devpd IMX952_PD_VPU>;
			cnm,ctrl = <&vpuctrl>;
