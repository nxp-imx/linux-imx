			clocks = <&scmi_clk IMX952_CLK_NPU>,
				 <&scmi_clk IMX952_CLK_NPUAPB>,
				 <&scmi_clk IMX952_CLK_CGC_NPU>;
			clock-names = "npu", "npu_apb, npu_cgc";
			power-domains = <&scmi_devpd IMX952_PD_NPU>;
