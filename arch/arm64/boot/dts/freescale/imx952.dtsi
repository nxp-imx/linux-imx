			interrupts = <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_VPUDEC>, <&scmi_clk IMX952_CLK_VPUAPB>;
			clock-names = "vpu", "vpuapb";
