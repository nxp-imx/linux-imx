			compatible = "nxp,imx95-camera-csr", "syscon";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x0 0x4ac10000 0x0 0x10000>;
			#clock-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_CAMAPB>;
			power-domains = <&scmi_devpd IMX952_PD_CAMERA>;

			csi_pixel_formatter_0: formatter@20 {
				compatible = "fsl,imx95-csi-formatter";
				reg = <0x20 0x100>;
				clocks = <&cameramix_csr IMX952_CLK_CAMBLK_CSI2_FOR0>;
				power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
				nxp,neoisp = <&neoisp0>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
					};

					port@1 {
						reg = <1>;
					};
				};
			};

			csi_pixel_formatter_1: formatter@120 {
				compatible = "fsl,imx95-csi-formatter";
				reg = <0x120 0x100>;
				clocks = <&cameramix_csr IMX952_CLK_CAMBLK_CSI2_FOR1>;
				power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
				nxp,neoisp = <&neoisp0>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
					};

					port@1 {
						reg = <1>;
					};
				};
			};
		};

		camera_phy_csr: syscon@4ad20000 {
			compatible = "syscon", "simple-mfd";
			reg = <0x0 0x4ad20000 0x0 0x10000>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_CAMAPB>;

			dphy_rx_0: dphy-rx@0 {
				compatible = "fsl,imx952-dphy-rx";
				#phy-cells = <0>;
				power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
				status = "disabled";
			};

			dphy_rx_1: dphy-rx@100 {
				compatible = "fsl,imx952-dphy-rx";
				reg = <0x100 0x10>;
				clocks = <&scmi_clk IMX952_CLK_CAMPHYCFG>,
					 <&scmi_clk IMX952_CLK_CGC_CAMCSI0>;
				clock-names = "phy_cfg", "csi0";
				assigned-clocks = <&scmi_clk IMX952_CLK_CAMPHYCFG>;
				assigned-clock-parents = <&scmi_clk IMX952_CLK_OSC24M>;
				assigned-clock-rates = <24000000>;
				#phy-cells = <0>;
				fsl,csis = <&mipi_csi_1>;
				power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
				status = "disabled";
			};
		};

		mipi_csi_0: csi@4ad30000 {
			compatible = "snps,dw-mipi-csi2", "syscon";
			reg = <0x0 0x4ad30000 0x0 0x10000>;
			interrupts = <GIC_SPI 374 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_CAMCSI0>;
			clock-names = "per";
			phys = <&dphy_rx_0>;
			phy-names = "dphy-rx";
			power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
				};

				port@1 {
					reg = <1>;
				};
			};
		};

		mipi_csi_1: csi@4ad40000 {
			compatible = "snps,dw-mipi-csi2", "syscon";
			reg = <0x0 0x4ad40000 0x0 0x10000>;
			interrupts = <GIC_SPI 375 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_CAMCSI1>;
			clock-names = "per";
			phys = <&dphy_rx_1>;
			phy-names = "dphy-rx";
			power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
			status = "disabled";
		};

		isi: isi@4ad50000 {
			compatible = "fsl,imx952-isi";
			reg = <0x0 0x4ad50000 0x0 0x80000>;
			interrupts = <GIC_SPI 221 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 346 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 347 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 348 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 349 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 350 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CAMAPB>,
				 <&scmi_clk IMX952_CLK_CGC_CAMISI>;
			clock-names = "apb", "axi";
			fsl,blk-ctrl = <&cameramix_csr>;
			power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
				};

				port@1 {
					reg = <1>;
				};

				port@2 {
					reg = <2>;
				};

				port@3 {
					reg = <3>;
				};
			};
		};

		neoisp0: isp@4ae00000 {
			compatible = "nxp,imx952-neoisp";
			reg = <0x0 0x4ae00000 0x0 0x8000>,
			      <0x0 0x4afe0000 0x0 0x10000>;
			reg-names = "registers", "stats";
			interrupts = <GIC_SPI 222 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&gic>;
			clocks = <&cameramix_csr IMX952_CLK_CAMBLK_ISP_AXI>,
				 <&cameramix_csr IMX952_CLK_CAMBLK_ISP_PIXEL>,
				 <&cameramix_csr IMX952_CLK_CAMBLK_ISP>,
				 <&scmi_clk IMX952_CLK_CGC_CAMISP>;
			clock-names = "camblk_isp_axi",
				      "camblk_isp_pixel",
				      "camblk_isp",
				      "cgc_camisp";
			power-domains = <&scmi_devpd IMX952_PD_CAMERA>;
			nxp,blk-ctrl = <&cameramix_csr>;
			status = "disabled";
		};

		hsio_blk_ctl: syscon@4c0100c0 {
			compatible = "nxp,imx95-hsio-blk-ctl", "syscon";
			reg = <0x0 0x4c0100c0 0x0 0x1>;
			#clock-cells = <1>;
			power-domains = <&scmi_devpd IMX952_PD_HSIO_TOP>;
			clocks = <&clk_dummy>;
		};

		usb1: usb@4c100000 {
			compatible = "fsl,imx95-usb", "fsl,imx7d-usb", "fsl,imx27-usb";
			reg = <0x0 0x4c100000 0x0 0x200>;
			interrupts = <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_HSIOUSB>,
				 <&scmi_clk IMX952_CLK_OSC32K>;
			clock-names = "usb_ctrl_root", "usb_wakeup";
			power-domains = <&scmi_devpd IMX952_PD_HSIO_TOP>;
			phys = <&usbphynop1>;
			fsl,usbmisc = <&usbmisc1 0>;
			status = "disabled";
		};

		usbmisc1: usbmisc@4c100200 {
			compatible = "fsl,imx95-usbmisc", "fsl,imx7d-usbmisc", "fsl,imx6q-usbmisc";
			#index-cells = <1>;
			reg = <0x0 0x4c100200 0x0 0x200>,
			      <0x0 0x4c010010 0x0 0x4>;
		};

		dispmix_csr: syscon@4b010000 {
			compatible = "nxp,imx952-display-csr", "syscon";
			reg = <0x0 0x4b010000 0x0 0x10000>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			assigned-clocks = <&scmi_clk IMX952_CLK_DISPAXI>,
					  <&scmi_clk IMX952_CLK_DISPAPB>,
					  <&scmi_clk IMX952_CLK_CGC_DISPOCRAM>;
			assigned-clock-parents = <&scmi_clk IMX952_CLK_SYSPLL1_PFD1>,
						 <&scmi_clk IMX952_CLK_SYSPLL1_PFD1_DIV2>;
			assigned-clock-rates = <400000000>, <133333333>, <400000000>;

			display_pixel_link: bridge@c {
				compatible = "nxp,imx952-dc-pixel-link";
				reg = <0xc 0x4>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						display_pixel_link0_to_pixel_interleaver_disp0: endpoint {
							remote-endpoint = <&pixel_interleaver_disp0_to_display_pixel_link0>;
						};
					};

					port@1 {
						reg = <1>;

						display_pixel_link1_to_pixel_interleaver_disp1: endpoint {
							remote-endpoint = <&pixel_interleaver_disp1_to_display_pixel_link1>;
						};
					};

					port@2 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <2>;

						display_pixel_link0_to_mipi_dsi: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&mipi_dsi_to_display_pixel_link0>;
						};

						display_pixel_link0_to_ldb_ch0: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&ldb_ch0_to_display_pixel_link0>;
						};
					};

					port@3 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <3>;

						display_pixel_link1_to_mipi_dsi: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&mipi_dsi_to_display_pixel_link1>;
						};

						display_pixel_link1_to_ldb_ch1: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&ldb_ch1_to_display_pixel_link1>;
						};
					};
				};
			};
		};

		mipi_dsi: dsi@4b060000 {
			compatible = "nxp,imx952-mipi-dsi2";
			reg = <0x0 0x4b060000 0x0 0x10000>;
			clocks = <&scmi_clk IMX952_CLK_MIPIPHYPLLBYPASS>,
				 <&scmi_clk IMX952_CLK_CGC_DISPDSI>,
				 <&scmi_clk IMX952_CLK_DISP1PIX>,
				 <&scmi_clk IMX952_CLK_DISP1PIX>,
				 <&mipi_dphy>;
			clock-names = "bypass", "pclk", "sys", "pix", "phy_pll";
			assigned-clocks = <&scmi_clk IMX952_CLK_MIPIPHYPLLBYPASS>,
					  <&scmi_clk IMX952_CLK_CGC_DISPDSI>;
			assigned-clock-parents = <&scmi_clk IMX952_CLK_VIDEOPLL1>,
						 <&scmi_clk IMX952_CLK_DISPAPB>;
			mux-controls = <&mux 0>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			nxp,display-dsi-csr = <&display_dsi_csr>;
			phys = <&mipi_dphy>;
			phy-names = "dphy";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;

					mipi_dsi_to_display_pixel_link0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&display_pixel_link0_to_mipi_dsi>;
					};

					mipi_dsi_to_display_pixel_link1: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&display_pixel_link1_to_mipi_dsi>;
					};
				};

				port@1 {
					reg = <1>;
				};
			};
		};

		dispmix_cm0p_csr: syscon@4b070000 {
			compatible = "nxp,imx952-display-cm0p-csr", "syscon";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x0 0x4b070000 0x0 0x10000>;
			#clock-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
		};

		dispmix_mu0: mailbox@4b080000 {
			compatible = "fsl,imx95-mu-cm0p";
			reg = <0x0 0x4b080000 0x0 0x10000>;
			interrupts = <GIC_SPI 408 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tx", "rx";
			#mbox-cells = <2>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			status = "disabled";
		};

		dispmix_mu1: mailbox@4b090000 {
			compatible = "fsl,imx95-mu-cm0p";
			reg = <0x0 0x4b090000 0x0 0x10000>;
			interrupts = <GIC_SPI 409 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "tx", "rx";
			#mbox-cells = <2>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			status = "disabled";
		};

		display_dsi_csr: syscon@4b0a0000 {
			compatible = "nxp,imx952-display-dsi-csr", "syscon";
			reg = <0x0 0x4b0a0000 0x0 0x10000>;
			#clock-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;

			mux: mux-controller {
				compatible = "mmio-mux";
				#mux-control-cells = <1>;
				mux-reg-masks = <0x4 0x00000001>; /* PXL_LINK_SEL */
				idle-states = <0>;
			};
		};

		displaymix_irqsteer: interrupt-controller@4b0b0000 {
			compatible = "fsl,imx-irqsteer";
			reg = <0x0 0x4b0b0000 0x0 0x1000>;
			interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 216 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 217 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>,	/* reserved */
				     <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>,	/* reserved */
				     <GIC_SPI 219 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
			clock-names = "ipg";
			fsl,channel = <0>;
			fsl,num-irqs = <512>;
			interrupt-controller;
			#interrupt-cells = <1>;
			status = "disabled";
		};

		lvds_csr: syscon@4b0c0000 {
			compatible = "nxp,imx952-lvds-csr", "nxp,imx95-lvds-csr", "syscon";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x0 0x4b0c0000 0x0 0x10000>;
			#clock-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;

			ldb: ldb@4 {
				compatible = "fsl,imx952-ldb", "fsl,imx95-ldb";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x4 0x4>;
				clocks = <&lvds_csr IMX952_CLK_DISPMIX_PIX_DI0_GATE>,
					 <&lvds_csr IMX952_CLK_DISPMIX_PIX_DI1_GATE>,
					 <&lvds_csr IMX952_CLK_DISPMIX_LVDS_CH0_GATE>,
					 <&lvds_csr IMX952_CLK_DISPMIX_LVDS_CH1_GATE>,
					 <&scmi_clk IMX952_CLK_LDBPLL>;
				clock-names = "ldb_di0", "ldb_di1", "ldb_ch0", "ldb_ch1", "ldb_pll";
				status = "disabled";

				channel@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					phys = <&ldb0_phy1>;
					phy-names = "lvds_phy";
					status = "disabled";

					port@0 {
						reg = <0>;

						ldb_ch0_to_display_pixel_link0: endpoint {
							remote-endpoint = <&display_pixel_link0_to_ldb_ch0>;
						};
					};

					port@1 {
						reg = <1>;
					};
				};

				channel@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
					phys = <&ldb1_phy1>;
					phy-names = "lvds_phy";
					status = "disabled";

					port@0 {
						reg = <0>;

						ldb_ch1_to_display_pixel_link1: endpoint {
							remote-endpoint = <&display_pixel_link1_to_ldb_ch1>;
						};
					};

					port@1 {
						reg = <1>;
					};
				};
			};

			ldb0_phy: phy@8 {
				compatible = "fsl,imx952-lvds0-phy", "fsl,imx95-lvds0-phy";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x8 0x4>;
				gpr = <&lvds_csr>;
				clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
				clock-names = "apb";
				power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
				status = "disabled";

				ldb0_phy1: port@0 {
					reg = <0>;
					#phy-cells = <0>;
				};
			};

			ldb1_phy: phy@c {
				compatible = "fsl,imx952-lvds1-phy", "fsl,imx95-lvds1-phy";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0xc 0x4>;
				gpr = <&lvds_csr>;
				clocks = <&scmi_clk IMX952_CLK_DISPAPB>;
				clock-names = "apb";
				power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
				status = "disabled";

				ldb1_phy1: port@0 {
					reg = <0>;
					#phy-cells = <0>;
				};
			};
		};

		pixel_interleaver: bridge@4b0d0000 {
			compatible = "nxp,imx952-pixel-interleaver";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x4b0d0000 0x0 0x20000>;
			interrupt-parent = <&displaymix_irqsteer>;
			interrupts = <62>;
			clocks = <&scmi_clk IMX952_CLK_CGC_DISPSEERIS>;
			nxp,blk-ctrl = <&dispmix_csr>;
			status = "disabled";

			channel@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				status = "disabled";

				port@0 {
					reg = <0>;

					pixel_interleaver_disp0_to_dpu_disp0: endpoint {
						remote-endpoint = <&dpu_disp0_to_pixel_interleaver_disp0>;
					};
				};

				port@1 {
					reg = <1>;

					pixel_interleaver_disp0_to_display_pixel_link0: endpoint {
						remote-endpoint = <&display_pixel_link0_to_pixel_interleaver_disp0>;
					};
				};
			};

			channel@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				status = "disabled";

				port@0 {
					reg = <0>;

					pixel_interleaver_disp1_to_dpu_disp1: endpoint {
						remote-endpoint = <&dpu_disp1_to_pixel_interleaver_disp1>;
					};
				};

				port@1 {
					reg = <1>;

					pixel_interleaver_disp1_to_display_pixel_link1: endpoint {
						remote-endpoint = <&display_pixel_link1_to_pixel_interleaver_disp1>;
					};
				};
			};
		};

		mipi_dphy: phy@4b110000 {
			compatible = "nxp,imx952-mipi-dphy";
			reg = <0x0 0x4b110000 0x0 0x40000>;
			#clock-cells = <0>;
			clocks = <&scmi_clk IMX952_CLK_DISPCDPHYAPB>,
				 <&scmi_clk IMX952_CLK_DISPPHYCFG>,
				 <&scmi_clk IMX952_CLK_DISPPHYCFG>;
			clock-names = "apb", "cfg", "ref";
			assigned-clocks = <&scmi_clk IMX952_CLK_DISPPHYCFG>;
			assigned-clock-parents = <&scmi_clk IMX952_CLK_OSC24M>;
			nxp,blk-ctrl = <&display_dsi_csr>;
			#phy-cells = <0>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			status = "disabled";
		};

		ocram_d_config: syscon@4b0f0000 {
			compatible = "nxp,imx95-ocram-config", "syscon";
			reg = <0x0 0x4b0f0000 0x0 0x10000>;
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
		};

		ocram_d: ocram@4b300000 {
			reg = <0x0 0x4b300000 0x0 0x4000>;
			no-map;
		};

		dpu: display-controller@4b400000 {
			compatible = "nxp,imx952-dpu";
			reg = <0x0 0x4b400000 0x0 0x400000>;
			interrupt-parent = <&displaymix_irqsteer>;
			interrupts = <448>, <449>, <450>,  <64>,
				      <65>,  <66>,  <67>,  <68>,
				      <69>, <192>, <193>, <194>,
				     <195>, <196>, <197>,  <70>,
				      <71>,  <72>,  <73>,  <74>,
				      <75>,  <76>,  <77>,  <78>,
				      <79>,  <80>,  <81>,  <82>,
				      <83>,  <84>,  <85>,  <86>,
				      <87>,  <88>,  <89>, <198>,
				     <199>, <200>, <201>, <202>,
				     <203>, <204>, <205>, <206>,
				     <207>, <208>, <209>, <210>,
				     <211>, <212>, <213>, <214>,
				     <451>,   <1>,   <2>,   <3>,
				       <4>,  <90>,  <91>,  <92>,
				      <93>,  <94>,  <95>,  <96>,
				      <97>,  <98>,  <99>, <100>,
				     <101>, <102>, <103>, <215>,
				     <216>, <217>, <218>, <219>,
				     <220>, <221>, <222>, <223>,
				     <224>, <225>, <226>, <227>,
				     <228>;
			interrupt-names = "store9_shdload",
					  "store9_framecomplete",
					  "store9_seqcomplete",
					  "extdst0_shdload",
					  "extdst0_framecomplete",
					  "extdst0_seqcomplete",
					  "extdst4_shdload",
					  "extdst4_framecomplete",
					  "extdst4_seqcomplete",
					  "extdst1_shdload",
					  "extdst1_framecomplete",
					  "extdst1_seqcomplete",
					  "extdst5_shdload",
					  "extdst5_framecomplete",
					  "extdst5_seqcomplete",
					  "domainblend0_shdload",
					  "domainblend0_framecomplete",
					  "disengcfg_shdload0",
					  "disengcfg_framecomplete0",
					  "disengcfg_seqcomplete0",
					  "framegen0_int0",
					  "framegen0_int1",
					  "framegen0_int2",
					  "framegen0_int3",
					  "sig0_shdload",
					  "sig0_valid",
					  "sig0_error",
					  "sig0_cluster_error",
					  "sig0_cluster_match",
					  "idhash0_shdload",
					  "idhash0_valid",
					  "idhash0_window_error",
					  "localdimming0_irq0",
					  "localdimming0_irq1",
					  "localdimming0_irq2",
					  "domainblend1_shdload",
					  "domainblend1_framecomplete",
					  "disengcfg_shdload1",
					  "disengcfg_framecomplete1",
					  "disengcfg_seqcomplete1",
					  "framegen1_int0",
					  "framegen1_int1",
					  "framegen1_int2",
					  "framegen1_int3",
					  "sig1_shdload",
					  "sig1_valid",
					  "sig1_error",
					  "sig1_cluster_error",
					  "sig1_cluster_match",
					  "idhash1_shdload",
					  "idhash1_valid",
					  "idhash1_window_error",
					  "cmdseq_error",
					  "comctrl_sw0",
					  "comctrl_sw1",
					  "comctrl_sw2",
					  "comctrl_sw3",
					  "framegen0_primsync_on",
					  "framegen0_primsync_off",
					  "framegen0_overflow0_on",
					  "framegen0_overflow0_off",
					  "framegen0_underrun0_on",
					  "framegen0_underrun0_off",
					  "framegen0_threshold0_rise",
					  "framegen0_threshold0_fail",
					  "framegen0_overflow1_on",
					  "framegen0_overflow1_off",
					  "framegen0_underrun1_on",
					  "framegen0_underrun1_off",
					  "framegen0_threshold1_rise",
					  "framegen0_threshold1_fail",
					  "framegen1_primsync_on",
					  "framegen1_primsync_off",
					  "framegen1_overflow0_on",
					  "framegen1_overflow0_off",
					  "framegen1_underrun0_on",
					  "framegen1_underrun0_off",
					  "framegen1_threshold0_rise",
					  "framegen1_threshold0_fail",
					  "framegen1_overflow1_on",
					  "framegen1_overflow1_off",
					  "framegen1_underrun1_on",
					  "framegen1_underrun1_off",
					  "framegen1_threshold1_rise",
					  "framegen1_threshold1_fail";
			clocks = <&scmi_clk IMX952_CLK_DISP1PIX>,
				 <&scmi_clk IMX952_CLK_CGC_DISPSEERIS>,
				 <&scmi_clk IMX952_CLK_DISPAXI>,
				 <&scmi_clk IMX952_CLK_CGC_DISPOCRAM>,
				 <&clk_ldb_pll_pixel>,
				 <&scmi_clk IMX952_CLK_LDBPLL_VCO>;
			clock-names = "pix", "apb", "axi", "ocram", "ldb", "ldb_vco";
			power-domains = <&scmi_devpd IMX952_PD_DISPLAY>;
			nxp,blk-ctrl = <&dispmix_csr>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					dpu_disp0_to_pixel_interleaver_disp0: endpoint {
						remote-endpoint = <&pixel_interleaver_disp0_to_dpu_disp0>;
					};
				};

				port@1 {
					reg = <1>;

					dpu_disp1_to_pixel_interleaver_disp1: endpoint {
						remote-endpoint = <&pixel_interleaver_disp1_to_dpu_disp1>;
					};
				};
			};
		};

		usb2: usb@4c200000 {
			compatible = "fsl,imx95-usb", "fsl,imx7d-usb", "fsl,imx27-usb";
			reg = <0x0 0x4c200000 0x0 0x200>;
			interrupts = <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_HSIOUSB>,
				 <&scmi_clk IMX952_CLK_OSC32K>;
			clock-names = "usb_ctrl_root", "usb_wakeup";
			power-domains = <&scmi_devpd IMX952_PD_HSIO_TOP>;
			phys = <&usbphynop2>;
			fsl,usbmisc = <&usbmisc2 0>;
			status = "disabled";
		};

		usbmisc2: usbmisc@4c200200 {
			compatible = "fsl,imx95-usbmisc", "fsl,imx7d-usbmisc", "fsl,imx6q-usbmisc";
			#index-cells = <1>;
			reg = <0x0 0x4c200200 0x0 0x200>,
			      <0x0 0x4c010014 0x0 0x4>;
		};

		pcie0: pcie@4c300000 {
			compatible = "fsl,imx95-pcie";
			reg = <0 0x4c300000 0 0x10000>,
			      <0 0x60100000 0 0xfe00000>,
			      <0 0x4c360000 0 0x10000>,
			      <0 0x4c340000 0 0x4000>;
			reg-names = "dbi", "config", "atu", "app";
			ranges = <0x81000000 0x0 0x00000000 0x0 0x6ff00000 0 0x00100000>,
				 <0x82000000 0x0 0x10000000 0x9 0x10000000 0 0x80000000>;
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			linux,pci-domain = <2>;
			/* Dev id(BIT[7:6)] 0x00,stream id(BIT[5:0]) 0x10~0x17 for pci0 */
			msi-map = <0x0 &its 0x10 0x1>,
				  <0x100 &its 0x11 0x7>;
			msi-map-mask = <0x1ff>; /* Suppose only 1 physic device connect */
			bus-range = <0x00 0xff>;
			num-lanes = <1>;
			num-viewport = <8>;
			interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "dma", "aer", "intr", "pme";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &gic 0 0 GIC_SPI 306 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 2 &gic 0 0 GIC_SPI 307 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 3 &gic 0 0 GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 4 &gic 0 0 GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_CGC_HSIOPCIE>,
				 <&scmi_clk IMX952_CLK_HSIOPLL_VCO>,
				 <&scmi_clk IMX952_CLK_HSIOPLL>,
				 <&scmi_clk IMX952_CLK_HSIOPCIEAUX>,
				 <&hsio_blk_ctl 0>;
			clock-names = "pcie", "pcie_bus", "pcie_phy", "pcie_aux", "ref";
			assigned-clocks =<&scmi_clk IMX952_CLK_HSIOPLL_VCO>,
					 <&scmi_clk IMX952_CLK_HSIOPLL>,
					 <&scmi_clk IMX952_CLK_HSIOPCIEAUX>;
			assigned-clock-rates = <3600000000>, <100000000>, <10000000>;
			assigned-clock-parents = <0>, <0>,
						 <&scmi_clk IMX952_CLK_SYSPLL1_PFD1_DIV2>;
			power-domains = <&scmi_devpd IMX952_PD_HSIO_TOP>;
			fsl,max-link-speed = <3>;
			status = "disabled";
		};

		pcie0_ep: pcie-ep@4c300000 {
			compatible = "fsl,imx95-pcie-ep";
			reg = <0 0x4c300000 0 0x10000>,
			      <0 0x4c360000 0 0x1000>,
			      <0 0x4c320000 0 0x1000>,
			      <0 0x4c340000 0 0x4000>,
			      <0 0x4c370000 0 0x10000>,
			      <0x9 0 1 0>;
			reg-names = "dbi","atu", "dbi2", "app", "dma", "addr_space";
			num-lanes = <1>;
			msi-map = <0x0 &its 0x11 0x1>;
			interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dma";
			clocks = <&scmi_clk IMX952_CLK_CGC_HSIOPCIE>,
				 <&scmi_clk IMX952_CLK_HSIOPLL_VCO>,
				 <&scmi_clk IMX952_CLK_HSIOPLL>,
				 <&scmi_clk IMX952_CLK_HSIOPCIEAUX>,
				 <&hsio_blk_ctl 0>;
			clock-names = "pcie", "pcie_bus", "pcie_phy", "pcie_aux", "ref";
			assigned-clocks =<&scmi_clk IMX952_CLK_HSIOPLL_VCO>,
					 <&scmi_clk IMX952_CLK_HSIOPLL>,
					 <&scmi_clk IMX952_CLK_HSIOPCIEAUX>;
			assigned-clock-rates = <3600000000>, <100000000>, <10000000>;
			assigned-clock-parents = <0>, <0>,
						 <&scmi_clk IMX952_CLK_SYSPLL1_PFD1_DIV2>;
			power-domains = <&scmi_devpd IMX952_PD_HSIO_TOP>;
			fsl,max-link-speed = <3>;
			status = "disabled";
		};

		mali: gpu@4d900000 {
			compatible = "arm,mali-valhall", "nxp,imx952-mali";
			reg = <0 0x4d900000 0 0x480000>;
			reg-names = "gpu_base";
			interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gpu", "job", "mmu";
			clocks = <&scmi_clk IMX952_CLK_GPU>;
			clock-names = "gpu";
			power-domains = <&scmi_devpd IMX952_PD_GPU>, <&scmi_perf IMX952_PERF_GPU>;
			power-domain-names = "gpumix", "gpuperf";
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;
			simple_power: power_model@0 {
			    compatible = "arm,mali-simple-power-model";
			    static-coefficient = <59073>;
			    dynamic-coefficient = <1013>;
			    reference_voltage = <920>;
			    ts = <20000 2000 (-20) 2>;
			    thermal-zone = "ana-thermal";
			};

			ipa_power:power_model@1 {
			    compatible = "arm,mali-tvax-power-model";
			    reference_voltage = <920>;
			};
		};

		netcmix_blk_ctrl: syscon@4c810000 {
			compatible = "nxp,imx95-netcmix-blk-ctrl", "syscon";
			reg = <0x0 0x4c810000 0x0 0x8>;
			#clock-cells = <1>;
			clocks = <&scmi_clk IMX952_CLK_CGC_NETC>;
			power-domains = <&scmi_devpd IMX952_PD_NETC>;
		};

		netc_blk_ctrl: netc-blk-ctrl@4cd20000 {
			compatible = "nxp,imx952-netc-blk-ctrl";
			reg = <0x0 0x4cd20000 0x0 0x10000>,
			      <0x0 0x4cd30000 0x0 0x10000>,
			      <0x0 0x4c81000c 0x0 0x1c>;
			reg-names = "ierb", "prb", "netcmix";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			power-domains = <&scmi_devpd IMX952_PD_NETC>;
			assigned-clocks = <&scmi_clk IMX952_CLK_ENET>,
					  <&scmi_clk IMX952_CLK_ENETREF>;
			assigned-clock-parents = <&scmi_clk IMX952_CLK_SYSPLL1_PFD1>,
						 <&scmi_clk IMX952_CLK_SYSPLL1_PFD0>;
			assigned-clock-rates = <266666666>, <250000000>;
			clocks = <&scmi_clk IMX952_CLK_CGC_NETC>;
			clock-names = "ipg";
			status = "disabled";

			netc_bus0: pcie@4ca00000 {
				compatible = "pci-host-ecam-generic";
				reg = <0x0 0x4ca00000 0x0 0x100000>;
				#address-cells = <3>;
				#size-cells = <2>;
				device_type = "pci";
				linux,pci-domain = <0>;
				bus-range = <0x0 0x0>;
				msi-map = <0x000 &its 0x60 0x1>, //ENETC0 PF
					  <0x001 &its 0x62 0x1>, //NETC Timer
					  <0x002 &its 0x63 0x1>, //EMDIO
					  <0x040 &its 0x64 0x1>; //ENETC0 VF
					  /* ENETC0 BAR0 - non-prefetchable memory */
				ranges = <0x82000000 0x0 0x4cc00000  0x0 0x4cc00000  0x0 0x40000
					  /* Timer and EMDIO BAR0/2 and ENETC0 VF BAR0 - non-prefetchable memory */
					  0x82000000 0x0 0x4cc80000  0x0 0x4cc80000  0x0 0x70000
					  /* ENETC0 VF BAR2 - non-prefetchable memory */
					  0x82000000 0x0 0x4cd00000  0x0 0x4cd00000  0x0 0x10000>;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0000 0 0 1 &gic 0 0
						 GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH>;
				status = "disabled";

				netc_enetc0: ethernet@0,0 {
					compatible = "pci1131,e101";
					reg = <0x00000 0 0 0 0>;
					clocks = <&scmi_clk IMX952_CLK_ENETREF>;
					clock-names = "ref";
					nvmem-cells = <&eth_mac0>;
					nvmem-cell-names = "mac-address";
					status = "disabled";
				};

				netc_timer: ptp-timer@0,1 {
					compatible = "pci1131,ee02";
					reg = <0x00100 0 0 0 0>;
					status = "disabled";
				};

				netc_emdio: mdio@0,2 {
					compatible = "pci1131,ee00";
					reg = <0x00200 0 0 0 0>;
					#address-cells = <1>;
					#size-cells = <0>;
					status = "disabled";
				};

				rcec@1,0 {
					reg = <0x00800 0 0 0 0>;
					interrupts = <1>;
				};
			};

			netc_bus1: pcie@4cb00000 {
				compatible = "pci-host-ecam-generic";
				reg = <0x0 0x4cb00000 0x0 0x100000>;
				#address-cells = <3>;
				#size-cells = <2>;
				device_type = "pci";
				linux,pci-domain = <1>;
				bus-range = <0x1 0x1>;
				msi-map = <0x100 &its 0x61 0x1>, //ENETC1 PF
					  <0x140 &its 0x65 0x1>; //ENETC1 VF
					  /* ENETC1 BAR0 - non-prefetchable memory */
				ranges = <0x82000000 0x0 0x4cc40000  0x0 0x4cc40000  0x0 0x40000
					  /* ENETC1: VF BAR0 - non-prefetchable memory */
					  0x82000000 0x0 0x4ccf0000  0x0 0x4ccf0000  0x0 0x10000
					  /* ENETC1: VF BAR2 - non-prefetchable memory */
					  0x82000000 0x0 0x4cd10000  0x0 0x4cd10000  0x0 0x10000>;
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0000 0 0 1 &gic 0 0
						 GIC_SPI 305 IRQ_TYPE_LEVEL_HIGH>;
				status = "disabled";

				netc_enetc1: ethernet@0,0 {
					compatible = "pci1131,e101";
					reg = <0x10000 0 0 0 0>;
					ptp-timer = <&netc_timer>;
					nvmem-cells = <&eth_mac1>;
					nvmem-cell-names = "mac-address";
					status = "disabled";
				};

				rcec@1,0 {
					reg = <0x10800 0 0 0 0>;
					interrupts = <1>;
				};
			};
		};

		sai2: sai@4c880000 {
			compatible = "fsl,imx952-sai", "fsl,imx95-sai";
			reg = <0x0 0x4c880000 0x0 0x10000>;
			interrupts = <GIC_SPI 169 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk IMX952_CLK_BUSNETCMIX>, <&clk_dummy>,
				 <&scmi_clk IMX952_CLK_SAI2>, <&clk_dummy>,
				 <&clk_dummy>;
