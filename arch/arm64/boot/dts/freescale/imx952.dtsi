				clock-names = "mem", "ipg",
					      "asrck_0", "asrck_1", "asrck_2", "asrck_3",
					      "asrck_4", "asrck_5", "asrck_6", "asrck_7",
					      "asrck_8", "asrck_9", "asrck_a", "asrck_b",
					      "asrck_c", "asrck_d", "asrck_e", "asrck_f",
