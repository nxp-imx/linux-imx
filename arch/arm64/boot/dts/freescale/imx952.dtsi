			dmas = <&edma2 59 0 FSL_EDMA_RX>, <&edma2 58 0 0>;
			dma-names = "rx", "tx";
			#sound-dai-cells = <0>;
			power-domains = <&scmi_devpd IMX952_PD_NETC>;
			status = "disabled";
		};

