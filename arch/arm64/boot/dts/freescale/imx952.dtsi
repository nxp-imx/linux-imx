				       <&edma2 100 0 FSL_EDMA_RX>, <&edma2 101 0 FSL_EDMA_RX>,
				       <&edma2 102 0 FSL_EDMA_RX>;
				/* tx* is output channel of asrc, it is rx channel for eDMA */
				dma-names = "rxa", "rxb", "rxc",
					    "txa", "txb", "txc";
				#sound-dai-cells = <0>;
				fsl,asrc-rate  = <8000>;
				fsl,asrc-width = <16>;
				status = "disabled";
