				clocks = <&scmi_clk IMX952_CLK_BUSWAKEUP>, <&clk_dummy>,
					 <&scmi_clk IMX952_CLK_SAI3>, <&clk_dummy>,
					 <&clk_dummy>;
				clock-names = "bus", "mclk0", "mclk1", "mclk2", "mclk3";
				dmas = <&edma2 61 0 FSL_EDMA_RX>, <&edma2 60 0 0>;
				dma-names = "rx", "tx";
				#sound-dai-cells = <0>;
				status = "disabled";
			};

