	v2x_sg0: secure-enclave-4 {
		compatible = "fsl,imx95-se";
		mboxes = <&v2x_mu3 0 0>,
			<&v2x_mu3 1 0>;
		mbox-names = "tx", "rx";
	};

	v2x_sg1: secure-enclave-5 {
		compatible = "fsl,imx95-se";
		mboxes = <&v2x_mu4 0 0>,
			<&v2x_mu4 1 0>;
		mbox-names = "tx", "rx";
	};

};
