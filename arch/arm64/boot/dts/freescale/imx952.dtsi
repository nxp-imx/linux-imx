		};

		vpuctrl: vpu-ctrl@4c4f0000 {
			compatible = "nxp,wave511-vpu-ctrl";
			reg = <0x0 0x4c4f0000 0x0 0x400>;
			clocks = <&scmi_clk IMX952_CLK_CGC_VPUDEC>, <&scmi_clk IMX952_CLK_VPUAPB>;
			power-domains = <&scmi_devpd IMX952_PD_VPU>;
		};

		jpegdec: jpegdec@4c500000 {
			compatible = "nxp,imx8qxp-jpgdec";
