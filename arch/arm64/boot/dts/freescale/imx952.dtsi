	ele_if0: secure-enclave-0 {
		compatible = "fsl,imx95-se";
		mbox-names = "tx", "rx";
		mboxes = <&elemu3 0 0>,
			 <&elemu3 1 0>;
	};

	v2x_dbg: secure-enclave-1 {
		compatible = "fsl,imx95-se";
		mbox-names = "tx", "rx";
		mboxes = <&v2x_mu 0 0>,
			<&v2x_mu 1 0>;
	};

	v2x_sv0: secure-enclave-2 {
		compatible = "fsl,imx95-se";
		mbox-names = "tx", "rx";
		mboxes = <&v2x_mu0 0 0>,
			<&v2x_mu0 1 0>;
	};

	v2x_she: secure-enclave-3 {
		compatible = "fsl,imx95-se";
		mbox-names = "tx", "rx";
		mboxes = <&v2x_mu2 0 0>,
			<&v2x_mu2 1 0>;
		status = "disabled";
