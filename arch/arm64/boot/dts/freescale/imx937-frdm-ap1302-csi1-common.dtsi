#include <dt-bindings/gpio/gpio.h>
#include "imx952-clock.h"

&{/} {
	reg_dvdd_1v2_csi1: regulator-dvdd-csi1 {
		compatible = "regulator-fixed";
		regulator-name = "DVDD_1V2_CSI1";
		gpio = <&adp5585_isp_csi1 7 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		enable-active-high;
	};

	reg_vddio_1v8_csi1: regulator-vddo-csi1 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_1V8_CSI1";
		gpio = <&adp5585_isp_csi1 6 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
	};

	reg_avdd_2v8_csi1: regulator-avdd-csi1 {
		compatible = "regulator-fixed";
		regulator-name = "AVDD_2V8_CSI1";
		gpio = <&adp5585_isp_csi1 8 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		enable-active-high;
	};

	reg_hmisc_vddio_csi1: regulator-hmisc-vddio-csi1 {
		compatible = "regulator-fixed";
		regulator-name = "HMISC_VDDIO_1V8_CSI1";
		gpio = <&adp5585_isp_csi1 10 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	adp5585_isp_csi1: io-expander-isp-csi1@34 {
		compatible = "adi,adp5585-01", "adi,adp5585";
		reg = <0x34>;
		gpio-controller;
		#gpio-cells = <2>;
		#pwm-cells = <3>;
	};

	ap1302_csi1: ap1302-mipi-csi1@3c {
		compatible = "onnn,ap1302";
		reg = <0x3c>;
		clocks = <&scmi_clk IMX952_CLK_OSC24M>;
		reset-gpios = <&gpio5 20 GPIO_ACTIVE_LOW>;
		isp_en-gpios = <&adp5585_isp_csi1 2 GPIO_ACTIVE_HIGH>;
		orientation = <2>;
		rotation = <0>;
		DVDD-supply = <&reg_dvdd_1v2_csi1>;
		VDDIO_HMISC-supply = <&reg_hmisc_vddio_csi1>;
		VDDIO_SMISC-supply = <&reg_hmisc_vddio_csi1>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
			};

			port@2 {
				reg = <2>;

				isp_out_csi1: endpoint {
					remote-endpoint = <&mipi_csi1_ep>;
					data-lanes = DATA_LANES;
				};
			};
		};

		sensors {
			#address-cells = <1>;
			#size-cells = <0>;

			onnn,model = "onnn,ar0144";

			sensor@0 {
				reg = <0>;

				vdd-supply = <&reg_dvdd_1v2_csi1>;
				vddio-supply = <&reg_vddio_1v8_csi1>;
				vaa-supply = <&reg_avdd_2v8_csi1>;
			};
		};
	};
};

&mipi_csi_1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			mipi_csi1_ep: endpoint {
				remote-endpoint = <&isp_out_csi1>;
				data-lanes = DATA_LANES;
				clock-lanes = <0>;
			};
		};

		port@1 {
			reg = <1>;

			mipi_csi1_out: endpoint {
				remote-endpoint = <&formatter_1_in>;
			};
		};
	};
};

&csi_pixel_formatter_1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			formatter_1_in: endpoint {
				remote-endpoint = <&mipi_csi1_out>;
			};
		};

		port@1 {
			reg = <1>;

			formatter_1_out: endpoint {
				remote-endpoint = <&isi_in_3>;
			};
		};
	};
};

&isi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@3 {
			reg = <3>;

			isi_in_3: endpoint {
				remote-endpoint = <&formatter_1_out>;
			};
		};
	};
};
