#include "imx8qxp-mek-rpmsg.dts"

&i2c_rpbus_1 {
	clock-frequency = <1000000>;
};

&i2c_rpbus_5 {
	clock-frequency = <1000000>;
};

&i2c_rpbus_15 {
	clock-frequency = <1000000>;
	isl29023@44 {
		status = "okay";
	};
};

&i2c_mipi_csi0 {
	clock-frequency = <1000000>;
};

&i2c0_mipi_lvds0 {
	clock-frequency = <500000>;
	adv7535@3d {
		status = "disabled";
	};
};

&i2c0_mipi_lvds1 {
	clock-frequency = <500000>;
	adv7535@3d {
		status = "disabled";
	};
};

&pwm_mipi_lvds0 {
	status = "disabled";
};

&lvds_backlight0 {
	status = "disabled";
};

&pwm_mipi_lvds1 {
	status = "disabled";
};

&lvds_backlight1 {
	status = "disabled";
};

&mipi0_dphy {
	status = "disabled";
};

&mipi0_dsi_host {
	status = "disabled";
};

&mipi1_dphy {
	status = "disabled";
};

&mipi1_dsi_host {
	status = "disabled";
};

&usdhc2 {
	status = "disabled";
};

&amix {
	status = "disabled";
};

&asrc0 {
	status = "disabled";
};

&wm8960 {
	quick-probe;
};

&vehicle_core {
	status = "okay";
};

/* used for can io expander */
&pca6416 {
	status = "disabled";
};

&ov5640 {
	status = "disabled";
};

&i2c_rpbus_12 {
	status = "disabled";
};

&i2c_rpbus_14 {
	status = "okay";

	fxos8700@1e {
		status = "okay";
	};
};

&adv_bridge0 {
	status = "disabled";
};

&adv_bridge1 {
	status = "disabled";
};

&fec2 {
	status = "disabled";
};

&flexspi0 {
	status = "disabled";
};

&parallel_csi {
	status = "disabled";
};

&sai4 {
	status = "disabled";
};

&sai5 {
	status = "disabled";
};

&lpuart3 {
	status = "disabled";
};

&crypto {
	status = "disabled";
};

&isi_4 {
	status = "disabled";
};

// ISI channel allocation
//
// ISI 0 - memory to memory for scaling and colorspace conversion
// ISI 1 - OV10635 ch 0
// ISI 2 - OV10635 ch 1
// ISI 3 - OV10635 ch 2
// ISI 4 - OV5640 PARALLEL_CSI
// ISI 5 - OV10635 ch 3

&isi_0 {
	interface = <5 0 2>; // Memory to memory

	cap_device {
		status = "disabled"; // No assigned camera
	};
};

&isi_1 {
	status = "okay";

	interface = <2 0 2>; // MIPI-CSI2, MIPI_VC0 to memory - VC as MIPI_VCx

	cap_device {
		status = "okay";
	};
};

&isi_2 {
	status = "okay";

	interface = <2 1 2>; // MIPI-CSI2, MIPI_VC1 to memory - VC as MIPI_VCx

	cap_device {
		status = "okay";
	};
};

&isi_3 {
	status = "okay";

	interface = <2 2 2>; // MIPI-CSI2, MIPI_VC2 to memory - VC as MIPI_VCx

	cap_device {
		status = "okay";
	};
};

&isi_4 {
	status = "okay";

	interface = <6 0 2>; // PARALLEL_CSI

	cap_device {
		status = "okay";
	};
};

&isi_5 {
	status = "okay";

	interface = <2 3 2>; // MIPI-CSI2, MIPI_VC3 to memory - VC as MIPI_VCx

	cap_device {
		status = "okay";
	};
};
