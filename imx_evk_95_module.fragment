CONFIG_ARCH_NXP=y
CONFIG_ARCH_MXC=y
CONFIG_ANDROID=y
CONFIG_IMX_GKI_FIX=y

#fsl_lpuart_95
CONFIG_SERIAL_FSL_LPUART=m
CONFIG_SERIAL_FSL_LPUART_CONSOLE=y

#imx95-dpu-drm
CONFIG_DRM_IMX95_DPU=m

#imx8-isi
CONFIG_VIDEO_IMX8_ISI=m
CONFIG_VIDEO_IMX8_ISI_M2M=y

#nxp-netc-lib
CONFIG_FSL_ENETC4=m
CONFIG_NXP_NETC_BLK_CTRL=m

#ptp_netc
CONFIG_PTP_1588_CLOCK_NETC=m

#pcs_xpcs
CONFIG_PCS_XPCS=m

#fsl-enetc-mdio
CONFIG_FSL_ENETC_MDIO=m

#fsl-enetc4
CONFIG_FSL_ENETC_QOS=y
CONFIG_NET_SCH_TAPRIO=m
CONFIG_NET_SCH_CBS=m
CONFIG_FSL_ENETC_VF=m

#mali_kbase
CONFIG_MALI_MIDGARD=m
#CONFIG_MALI_PLATFORM_NAME="imx"
CONFIG_MALI_REAL_HW=y
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_DEVFREQ=y
CONFIG_MALI_GATOR_SUPPORT=y
CONFIG_MALI_TRACE_POWER_GPU_WORK_PERIOD=y
CONFIG_MALI_HW_ERRATA_1485982_NOT_AFFECTED=y

#aquantia
CONFIG_HWMON=m

#ox05b1s_mipi
CONFIG_VIDEO_OX05B1S=m
